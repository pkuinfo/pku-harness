{
  "expo": {
    "name": "PKU Harness",
    "slug": "pku-harness",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pkuharness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.pkuinfo.harness",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "pku.edu.cn": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        }
      }
    },
    "android": {
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.pkuinfo.harness",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#F0444F",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "shortService",
                "dataSync"
              ]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 PKU Harness 访问相册，以便把图片作为附件发给 AI 助手",
          "cameraPermission": "允许 PKU Harness 使用相机，以便拍照后作为附件发给 AI 助手",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "zh-Hans",
            "en"
          ],
          "supportsRTL": false
        }
      ],
      "./config-plugins/with-debug-user-ca",
      "./config-plugins/with-release-signing",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Expo builds module views by reflection with (Context, AppContext). expo-modules-core keeps that\n# constructor only for ExpoView subclasses; expo-gl's GLView extends TextureView, so R8 stripped it\n# and every fresh install crashed on the welcome screen. Keep the constructor wherever it exists.\n-keepclassmembers class * {\n  public <init>(android.content.Context, expo.modules.kotlin.AppContext);\n}\n# expo-gl's native code (EXGLJniApi.cpp) looks up GLContext.flush() by name over JNI; R8\n# renamed it and the JS thread aborted. expo-gl is small: keep it whole.\n-keep class expo.modules.gl.** { *; }\n"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07080A",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://harness.novadiffusion.com/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "codeSigningCertificate": "./certs/ota/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
