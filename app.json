{
  "expo": {
    "name": "PKU Harness",
    "slug": "pku-harness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pkuharness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.pkuinfo.harness",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "pku.edu.cn": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.pkuinfo.harness",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#F0444F",
          "enableRemoteNotifications": false
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "shortService",
                "dataSync"
              ]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 PKU Harness 访问相册，以便把图片作为附件发给 AI 助手",
          "cameraPermission": "允许 PKU Harness 使用相机，以便拍照后作为附件发给 AI 助手",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "zh-Hans",
            "en"
          ],
          "supportsRTL": false
        }
      ],
      "./config-plugins/with-debug-user-ca"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07080A"
  }
}
